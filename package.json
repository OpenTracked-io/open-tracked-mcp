{
  "name": "open-tracked-mcp",
  "version": "0.1.0",
  "description": "MCP server for Open Tracked: your containers, domains, tracking score and power-ups, plus every Google Tag Manager tool, and one-step install of the Open Tracked tags into a GTM workspace.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "open-tracked-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod 755 dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "google-tag-manager-mcp-core": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTracked-io/open-tracked-mcp.git"
  },
  "homepage": "https://opentracked.io/solutions/open-tracked-mcp-server",
  "bugs": {
    "url": "https://github.com/OpenTracked-io/open-tracked-mcp/issues"
  }
}
